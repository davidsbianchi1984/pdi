<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdiVault.Views.ResidentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PdiScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="680" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PdiTxtBrush}" />
            <TextBlock x:Name="MeansText" Foreground="{StaticResource PdiT2Brush}" FontSize="13" TextWrapping="Wrap" />
            <TextBlock x:Name="PostureText" Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="ToolsText" Foreground="{StaticResource PdiT2Brush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock x:Name="PrivacyText" Foreground="{StaticResource PdiT2Brush}" FontSize="11" TextWrapping="Wrap" />

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Name="GoalBox" />
                    <!-- A standing task: the vault keeps the appointment. -->
                    <TextBox x:Name="EveryBox" />
                    <Button x:Name="PlanButton" Click="OnPlan"
                            Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TasksHeader" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PdiTxtBrush}" />
            <ItemsControl x:Name="TasksList" />

            <TextBlock x:Name="DatasetsHeader" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PdiTxtBrush}" />
            <ItemsControl x:Name="DatasetsList" />
            <TextBlock x:Name="RowsText" Foreground="{StaticResource PdiT2Brush}" FontSize="11" TextWrapping="Wrap" />

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="EmbedHeader" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBox x:Name="EmbedKeyBox" />
                    <TextBox x:Name="EmbedTextBox" />
                    <Button x:Name="EmbedButton" Click="OnEmbed"
                            Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                    <TextBox x:Name="QueryBox" />
                    <Button x:Name="SearchButton" Click="OnSearch"
                            Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                    <TextBlock x:Name="MatchesText" Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBox x:Name="ForgetBox" Visibility="Collapsed" />
                    <Button x:Name="ForgetButton" Click="OnForget"
                            Background="Transparent" Foreground="{StaticResource PdiRed}" />
                    <!-- The voice door: one local turn, straight through. -->
                    <TextBox x:Name="PromptBox" />
                    <Button x:Name="InferButton" Click="OnInfer"
                            Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                    <Button x:Name="AskVaultButton" Click="OnAskVault"
                            Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                    <TextBlock x:Name="SpokenText" Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="{StaticResource PdiGreenBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource PdiRed}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
