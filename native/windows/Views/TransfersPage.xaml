<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdiVault.Views.TransfersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PdiScrBotBrush}">

    <Pivot MaxWidth="680" Margin="20,12" Foreground="{StaticResource PdiTxtBrush}">

        <!-- Outbound: seal a file for a recipient -->
        <PivotItem x:Name="NtrTOutbound" >
    <ScrollViewer>
        <StackPanel Spacing="14" Padding="4" HorizontalAlignment="Left">
            <TextBlock x:Name="TabTransfers"  FontSize="22" FontWeight="Bold" Foreground="{StaticResource PdiTxtBrush}" />
            <TextBlock x:Name="NfilSub" 
                       Foreground="{StaticResource PdiT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBox x:Name="RecipientBox"   />
                    <TextBox x:Name="FilenameBox"   />
                    <TextBox x:Name="ContentBox"  
                             AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                    <TextBlock x:Name="ProgramsLabel" FontSize="12"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <ItemsControl x:Name="ProgramChips">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Key}" IsChecked="{Binding Selected, Mode=TwoWay}"
                                          Foreground="{StaticResource PdiTxtBrush}" MinWidth="0" Margin="0,0,8,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="CreateButton"  HorizontalAlignment="Stretch"
                            Height="42" Foreground="White" Click="OnCreate">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource PdiBrandA}" Offset="0" />
                                <GradientStop Color="#FF3AA0FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource PdiRed}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Border x:Name="TokenCard" Background="{StaticResource PdiCardBrush}"
                    BorderBrush="{StaticResource PdiLineBrush}" BorderThickness="1" CornerRadius="16"
                    Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="NfilTokenOnce"  FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="TokenText" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource PdiT2Brush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="NfilTokenHand" 
                               Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="TransfersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="{Binding Filename}" FontWeight="Bold"
                                               Foreground="{StaticResource PdiTxtBrush}" />
                                    <TextBlock Text="{Binding Status}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                                </Grid>
                                <TextBlock Text="{Binding Meta}" Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding RefreshLabel}" Tag="{Binding Id}" Click="OnTransferRefresh"
                                            Background="Transparent" FontSize="12"
                                            Foreground="{StaticResource PdiBrandABrush}" />
                                    <Button Content="{Binding ChainLabel}" Tag="{Binding Id}" Click="OnTransferChain"
                                            Background="Transparent" FontSize="12"
                                            Foreground="{StaticResource PdiBrandABrush}" />
                                    <Button Content="{Binding ReceiveLabel}" Tag="{Binding Id}" Click="OnTransferReceive"
                                            Background="Transparent" FontSize="12"
                                            Foreground="{StaticResource PdiBrandABrush}" />
                                    <Button Content="{Binding CheckLinkLabel}" Tag="{Binding Id}" Click="OnCheckLink"
                                            Background="Transparent" FontSize="12"
                                            Foreground="{StaticResource PdiBrandABrush}" />
                                    <Button Content="{Binding RevokeLabel}" Tag="{Binding Id}" Click="OnRevoke"
                                            Visibility="{Binding RevokeVisibility}"
                                            Background="Transparent" Foreground="{StaticResource PdiRed}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
        </PivotItem>

        <!-- Intake: request a file in; the sender submits with a one-shot token -->
        <PivotItem x:Name="NtrTIntake" >
            <ScrollViewer>
                <StackPanel Spacing="14" Padding="4" HorizontalAlignment="Left">
                    <TextBlock x:Name="NtrIntake"  FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="NtrIntakeSub" 
                               Foreground="{StaticResource PdiT2Brush}" FontSize="13" TextWrapping="Wrap" />

                    <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBox x:Name="FromBox"   />
                            <TextBox x:Name="PurposeBox"   />
                            <ItemsControl x:Name="IntakeProgramChips">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Key}" IsChecked="{Binding Selected, Mode=TwoWay}"
                                                  Foreground="{StaticResource PdiTxtBrush}" MinWidth="0" Margin="0,0,8,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="RequestButton"  HorizontalAlignment="Stretch"
                                    Height="42" Foreground="White" Click="OnRequestIntake">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource PdiBrandA}" Offset="0" />
                                        <GradientStop Color="#FF3AA0FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="IntakeError" Foreground="{StaticResource PdiRed}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />

                    <Border x:Name="SubmitTokenCard" Background="{StaticResource PdiCardBrush}"
                            BorderBrush="{StaticResource PdiLineBrush}" BorderThickness="1" CornerRadius="16"
                            Padding="16" Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="NintTokenOnce"  FontWeight="Bold" FontSize="15"
                                       Foreground="{StaticResource PdiTxtBrush}" />
                            <TextBlock x:Name="SubmitTokenText" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource PdiT2Brush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="NintTokenSend" 
                                       Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="IntakesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Text="{Binding FromParty}" FontWeight="Bold"
                                                       Foreground="{StaticResource PdiTxtBrush}" />
                                            <TextBlock Text="{Binding Status}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                                        </Grid>
                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                                        <TextBlock Text="{Binding FileText}" Foreground="{StaticResource PdiT2Brush}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Visibility="{Binding FileVisibility}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{Binding RefreshLabel}" Tag="{Binding Id}" Click="OnIntakeRefresh"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource PdiBrandABrush}" />
                                            <Button Content="{Binding ChainLabel}" Tag="{Binding Id}" Click="OnIntakeChain"
                                                    Background="Transparent" FontSize="12"
                                                    Foreground="{StaticResource PdiBrandABrush}" />
                                            <Button Content="{Binding ReadLabel}" Tag="{Binding Id}" Click="OnReadIntake"
                                                    Visibility="{Binding ReadVisibility}"
                                                    Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                                            <Button Content="{Binding CloseLabel}" Tag="{Binding Id}" Click="OnCloseIntake"
                                                    Visibility="{Binding CloseVisibility}"
                                                    Background="Transparent" Foreground="{StaticResource PdiRed}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="NtrAsSender"  FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource PdiTxtBrush}" />
                            <TextBlock x:Name="NtrAnswerSub" 
                                       Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBox x:Name="SenderTokenBox"   />
                            <TextBox x:Name="SenderFileBox"   />
                            <TextBox x:Name="SenderContentBox"   />
                            <Button x:Name="NintGo"  HorizontalAlignment="Stretch"
                                    Height="38" Click="OnSubmitIntake"
                                    Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- Carriers: custody codes on sealed things — the sticker, everyone
             who rang it, and the pairing card. -->
        <PivotItem x:Name="CarPivot">
            <ScrollViewer>
                <StackPanel Spacing="12" Padding="4">
                    <TextBlock x:Name="CarHead" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="CarPlaceHead" FontWeight="Bold"
                                       Foreground="{StaticResource PdiTxtBrush}" />
                            <TextBox x:Name="CarLabelBox" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton x:Name="CarBlind" Click="OnDiscloseBlind" FontSize="12" />
                                <ToggleButton x:Name="CarContact" Click="OnDiscloseContact" FontSize="12" />
                                <Button x:Name="CarPlaceButton" Click="OnPlaceCarrier"
                                        Background="{StaticResource PdiBrandABrush}" Foreground="White" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CarError" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiRed}" />
                    <TextBlock x:Name="CarNone" FontSize="12"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <StackPanel x:Name="CarRows" Spacing="8" />
                    <Border x:Name="CarCardPanel" Visibility="Collapsed"
                            Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel x:Name="CarCard" Spacing="4" />
                    </Border>
                    <Border x:Name="CarChainPanel" Visibility="Collapsed"
                            Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel x:Name="CarChain" Spacing="4" />
                    </Border>
                    <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="CarRangHead" FontWeight="Bold"
                                       Foreground="{StaticResource PdiTxtBrush}" />
                            <TextBlock x:Name="CarNoRings" FontSize="12"
                                       Foreground="{StaticResource PdiT2Brush}" />
                            <StackPanel x:Name="CarRings" Spacing="4" />
                            <TextBlock x:Name="CarTranscript" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource PdiT2Brush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel x:Name="CarPair" Spacing="2" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</Page>
