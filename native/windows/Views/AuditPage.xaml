<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdiVault.Views.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PdiScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PdiTxtBrush}" />
            <TextBlock x:Name="DescText"
                       Foreground="{StaticResource PdiT2Brush}" FontSize="13" TextWrapping="Wrap" />

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="StatusText" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiGreenBrush}" />
                    <TextBlock x:Name="AcceptText" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="CountText"
                               Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="EntriesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Seq}" Foreground="{StaticResource PdiT2Brush}"
                                           FontFamily="Consolas" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Action}" FontWeight="Bold"
                                               Foreground="{StaticResource PdiTxtBrush}" />
                                    <TextBlock Text="{Binding Ref}" Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Category}" VerticalAlignment="Center"
                                           Foreground="{StaticResource PdiBrandABrush}" FontSize="12" FontWeight="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The notice that has to be answered before anything leaves this
                 machine, and the switch that turns it off afterwards. The
                 preview below is built by Problems.Report — the same function
                 the sender posts — so what is shown is the payload rather than
                 a description of it. -->
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ProblemsTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="ProblemsExplain" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <StackPanel x:Name="ProblemsAsk" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ProblemsYes" Click="OnProblemsYes" />
                        <Button x:Name="ProblemsNo" Click="OnProblemsNo" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ProblemsSwitch"
                                  Toggled="OnProblemsToggled" Visibility="Collapsed" />
                    <HyperlinkButton x:Name="ProblemsPreviewButton"
                                     Click="OnProblemsPreview" />
                    <TextBlock x:Name="ProblemsPreview" FontSize="11" TextWrapping="Wrap"
                               FontFamily="Consolas" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PasswordBox x:Name="ProblemsKeyBox" Width="220" />
                        <Button x:Name="ProblemsFetchButton" Click="OnProblemsFetch" />
                    </StackPanel>
                    <TextBlock x:Name="ProblemsServerRows" FontSize="11" TextWrapping="Wrap"
                               FontFamily="Consolas" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
