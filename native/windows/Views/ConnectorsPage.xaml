<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdiVault.Views.ConnectorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PdiScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PdiTxtBrush}" />
            <TextBlock x:Name="SubText"
                       Foreground="{StaticResource PdiT2Brush}" FontSize="13" TextWrapping="Wrap" />
            <TextBlock x:Name="CatalogText" Foreground="{StaticResource PdiT2Brush}" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <ComboBox x:Name="PlatformBox" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="HandleBox" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CollectButton" Click="OnConnectCollect"
                                Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="PublishButton" Click="OnConnectPublish"
                                Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource PdiRed}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource PdiGreenBrush}" FontSize="12"
                       Visibility="Collapsed" />
            <TextBlock x:Name="BeaconText" Foreground="{StaticResource PdiT2Brush}" FontSize="11"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />

            <ItemsControl x:Name="ConnsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                               Foreground="{StaticResource PdiTxtBrush}" />
                                    <TextBlock Text="{Binding Handle}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding IngestLabel}" Tag="{Binding Id}" Click="OnIngest"
                                            Visibility="{Binding IngestVisibility}"
                                            Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                                    <Button Content="{Binding ScrapeLabel}" Tag="{Binding Id}" Click="OnScrape"
                                            Visibility="{Binding ScrapeVisibility}"
                                            Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                                    <Button Content="{Binding UpdateLabel}" Tag="{Binding Id}" Click="OnPublish"
                                            Visibility="{Binding PublishVisibility}"
                                            Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                                    <Button Content="{Binding BeaconLabel}" Tag="{Binding Id}" Click="OnBeacon"
                                            Visibility="{Binding PublishVisibility}"
                                            Background="Transparent" Foreground="{StaticResource PdiBrandABrush}" />
                                    <Button Content="{Binding DisconnectLabel}" Tag="{Binding Id}" Click="OnRevoke"
                                            Background="Transparent" Foreground="{StaticResource PdiRed}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
