<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdiVault.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PdiScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="9" Height="9" Fill="{StaticResource PdiGreenBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Vault unlocked" Foreground="{StaticResource PdiGreenBrush}"
                           FontWeight="Bold" FontSize="12" />
            </StackPanel>
            <TextBlock Text="Your vault" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PdiTxtBrush}" />
            <TextBlock Text="Records are sealed at rest; every access is hash-chained in the audit log."
                       Foreground="{StaticResource PdiT2Brush}" FontSize="14" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RecordsValue" Text="—" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PdiBrandABrush}" />
                        <TextBlock Text="Records" Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="AuditValue" Text="—" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PdiGreenBrush}" />
                        <TextBlock Text="Audit" Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Token" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="TokenText" FontFamily="Consolas" Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="BaseText" FontSize="12" Foreground="{StaticResource PdiT2Brush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Language" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock Text="PDI's explanatory notes arrive in this language; sealed data is untouched."
                               FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource PdiT2Brush}" />
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnLanguagePicked" />
                    <ToggleSwitch x:Name="PreTranslateToggle" Header="Pre-translate notes"
                                  OnContent="Translated notes in every response"
                                  OffContent="English notes kept"
                                  IsOn="True" Toggled="OnModeToggled" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Help us improve" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock Text="Tell us how to make PDI better — an idea, a rough edge, a bug, or what you love. It goes straight to the team."
                               Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="ImproveCategory" Header="Category" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="ImproveMessage" PlaceholderText="What's on your mind?"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="80" />
                    <ComboBox x:Name="ImproveRating" Header="Rating (optional)" HorizontalAlignment="Stretch" />
                    <Button Content="Send feedback" Click="OnSendImprovement"
                            Background="{StaticResource PdiBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="ImproveThanks" Foreground="{StaticResource PdiGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ImproveTally" Foreground="{StaticResource PdiT2Brush}" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ImproveMineHeader" Text="Yours" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource PdiTxtBrush}" Visibility="Collapsed" />
                    <ItemsControl x:Name="ImproveMine">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" Foreground="{StaticResource PdiT2Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
