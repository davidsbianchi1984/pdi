<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PdiVault.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PdiScrBotBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Spacing="14" Padding="28" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="9" Height="9" Fill="{StaticResource PdiGreenBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="UnlockedText" Foreground="{StaticResource PdiGreenBrush}"
                           FontWeight="Bold" FontSize="12" />
            </StackPanel>
            <TextBlock x:Name="VaultTitle" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PdiTxtBrush}" />
            <TextBlock x:Name="SealedText"
                       Foreground="{StaticResource PdiT2Brush}" FontSize="14" TextWrapping="Wrap" />
            <Button x:Name="RefreshButton" Click="OnRefresh"
                    Background="Transparent" FontSize="12"
                    Foreground="{StaticResource PdiBrandABrush}" />

            <!-- What this deployment can and cannot reach. Read-only: the
                 posture is set in the deployment's environment, not by
                 somebody signed into the app. -->
            <Border x:Name="OfflineCard" Background="{StaticResource PdiCardBrush}"
                    BorderBrush="{StaticResource PdiLineBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="OfflineTitle" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource PdiTxtBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="OfflineState" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource PdiGreenBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="OfflineLocal" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="OfflineGuarantees" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource PdiT2Brush}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RecordsValue" Text="—" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PdiBrandABrush}" />
                        <TextBlock x:Name="RecordsLabel" Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16" MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="AuditValue" Text="—" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PdiGreenBrush}" />
                        <TextBlock x:Name="AuditLabel" Foreground="{StaticResource PdiT2Brush}" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TokenLabel" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="TokenText" FontFamily="Consolas" Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="BaseText" FontSize="12" Foreground="{StaticResource PdiT2Brush}" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="LanguageHead" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="NotesText"
                               FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource PdiT2Brush}" />
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnLanguagePicked" />
                    <ToggleSwitch x:Name="PreTranslateToggle"
                                  IsOn="True" Toggled="OnModeToggled" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ImproveTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="ImproveSub"
                               Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="ImproveCategory" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="ImproveMessage"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="80" />
                    <ComboBox x:Name="ImproveRating" HorizontalAlignment="Stretch" />
                    <Button x:Name="ImproveSend" Click="OnSendImprovement"
                            Background="{StaticResource PdiBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="ImproveThanks" Foreground="{StaticResource PdiGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ImproveTally" Foreground="{StaticResource PdiT2Brush}" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ImproveMineHeader" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource PdiTxtBrush}" Visibility="Collapsed" />
                    <ItemsControl x:Name="ImproveMine">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" Foreground="{StaticResource PdiT2Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- Ability is not a gate: the accessibility report door. Three
                 questions, none a diagnosis, sent with no token. The admin
                 row reads them back with the deployment's own token. -->
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="AccHead" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="AccLead"
                               Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <!-- The per-need statement the console makes, not just its form. -->
                    <TextBlock x:Name="AccNeedsTitle" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource PdiTxtBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AccNeedsList"
                               Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="AccNeedsMore" FontStyle="Italic"
                               Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBox x:Name="AccDoing" TextWrapping="Wrap" AcceptsReturn="True" Height="56" />
                    <TextBox x:Name="AccWall" TextWrapping="Wrap" AcceptsReturn="True" Height="72" />
                    <TextBox x:Name="AccHelp" TextWrapping="Wrap" AcceptsReturn="True" Height="56" />
                    <Button x:Name="AccSend" Click="OnSendAccessReport"
                            Background="{StaticResource PdiBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="AccThanks" Foreground="{StaticResource PdiGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <PasswordBox x:Name="AccReviewerBox" />
                    <Button x:Name="AccLoad" Click="OnLoadAccessReports" FontSize="12" />
                    <TextBlock x:Name="AccEmpty" Foreground="{StaticResource PdiT2Brush}" FontSize="11"
                               Visibility="Collapsed" />
                    <ItemsControl x:Name="AccReportsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" Foreground="{StaticResource PdiT2Brush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="AdminTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="AdminReq"
                               Foreground="{StaticResource PdiT2Brush}" FontSize="12" TextWrapping="Wrap" />
                    <PasswordBox x:Name="AdminTokenBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- The portability door: counts on the desktop
                             shell, the document itself in the console. -->
                        <Button x:Name="AdminDsr"
                                Click="OnExportEverything" />
                        <Button x:Name="AdminLoad" Click="OnLoadKeys"
                                Background="{StaticResource PdiBrandABrush}" Foreground="White" FontSize="12" />
                        <Button x:Name="RotateButton" Click="OnRotateKey" IsEnabled="False"
                                Background="{StaticResource PdiBrandABrush}" Foreground="White" FontSize="12" />
                        <Button x:Name="RetireButton" Click="OnRetireKeys" IsEnabled="False"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiRedBrush}" />
                    </StackPanel>
                    <ItemsControl x:Name="KeyList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}" FontSize="12" FontFamily="Consolas"
                                           Foreground="{StaticResource PdiT2Brush}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="AdminStatus" Foreground="{StaticResource PdiGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="AdminError" Foreground="{StaticResource PdiRedBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Tenants: the operator's half — create, restore, delete,
                 mint, retention, and the BAA. Same PDI_ADMIN_TOKEN. -->
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="TnTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <PasswordBox x:Name="TnAdminTokenBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="TnNameBox" Width="220" />
                        <Button x:Name="TnCreateButton" Click="OnCreateTenant"
                                Background="{StaticResource PdiBrandABrush}" Foreground="White" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="TnMade" FontSize="11" FontFamily="Consolas" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="TnMadeNote" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBox x:Name="TnIdBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TnRestoreButton" Click="OnTenantRestore"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="TnDelSoftButton" Click="OnTenantDelSoft"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="TnDelHardButton" Click="OnTenantDelHard"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiRedBrush}" />
                        <Button x:Name="TnMintReadButton" Click="OnMintRead"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="TnMintWriteButton" Click="OnMintWrite"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="TnMinted" FontSize="11" FontFamily="Consolas" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="TnMintedNote" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <Button x:Name="TnRevokeButton" Click="OnRevokeMinted"
                            Background="Transparent" FontSize="12" Visibility="Collapsed"
                            Foreground="{StaticResource PdiRedBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="TnRetentionBox" Width="160" />
                        <Button x:Name="TnRetentionButton" Click="OnSetTenantRetention"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="TnBaaHead" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBox x:Name="TnCustBox" />
                    <TextBox x:Name="TnOpBox" />
                    <TextBox x:Name="TnEffBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TnBaaRecordButton" Click="OnBaaRecord"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="TnBaaReadButton" Click="OnBaaRead"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="TnBaaRescindButton" Click="OnBaaRescind"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiRedBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="TnBaaLine" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="TnError" Foreground="{StaticResource PdiRedBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- The agent at the gate: what it may do, who is on shift, and
                 what it sent when nobody was. Tenant token. -->
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="GateTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="GateCeilingText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="GateChannelText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="GateShiftHead" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <StackPanel x:Name="GateRosterRows" Spacing="4" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="GateNameBox" Width="140" />
                        <TextBox x:Name="GateRoleBox" Width="120" />
                        <Button x:Name="GateAddButton" Click="OnRosterAdd"
                                Background="{StaticResource PdiBrandABrush}" Foreground="White" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="GateTzBox" Width="180" />
                        <Button x:Name="GateTzButton" Click="OnGateTz"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="GateSentHead" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="GateSentNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <StackPanel x:Name="GatePageRows" Spacing="4" />
                    <TextBlock x:Name="GateError" Foreground="{StaticResource PdiRedBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Continuity: bequests through their whole life, contributions,
                 the snapshot pair, and the retention ops. -->
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="CtTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="CtNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <StackPanel x:Name="CtRows" Spacing="4" />
                    <TextBox x:Name="CtGranteeBox" />
                    <TextBox x:Name="CtPrefixesBox" />
                    <TextBox x:Name="CtNoteBox" />
                    <Button x:Name="CtRecordButton" Click="OnBequestRecord"
                            Background="{StaticResource PdiBrandABrush}" Foreground="White" FontSize="12" />
                    <TextBlock x:Name="CtActHead" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="CtActNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <PasswordBox x:Name="CtAdminBox" />
                    <TextBox x:Name="CtRefBox" />
                    <TextBlock x:Name="CtMinted" FontSize="11" FontFamily="Consolas" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="CtRedeemHead" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="CtRedeemNote" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBox x:Name="CtGrantBox" />
                    <PasswordBox x:Name="CtCustKeyBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CtKeysButton" Click="OnBequestKeys"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="CtReadButton" Click="OnBequestRead"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="CtHeirKeys" FontSize="11" FontFamily="Consolas" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="CtReadBack" FontSize="11" FontFamily="Consolas" IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" Visibility="Collapsed" MaxHeight="80"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="CtContribHead" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="CtContribLine" FontSize="11"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="CtSourceBox" Width="180" />
                        <TextBox x:Name="CtContribRefBox" Width="140" />
                        <Button x:Name="CtContribButton" Click="OnContribute"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="CtWithdrawButton" Click="OnWithdraw"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiRedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CtSnapshotButton" Click="OnSnapshot"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="CtRestoreButton" Click="OnRestoreSnapshot"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="CtWindowButton" Click="OnRetentionWindow"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="CtSweepButton" Click="OnRetentionSweep"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="CtSeedButton" Click="OnSeedDemo"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="CtOpsLine" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="CtStatus" Foreground="{StaticResource PdiGreenBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="CtError" Foreground="{StaticResource PdiRedBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Posture: where the vault lives, and whether it is up. -->
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="PoTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="PoHealth" FontSize="11"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="PoWhereHead" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBox x:Name="PoTidBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PoWhereButton" Click="OnHostingRead"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="PoDeployButton" Click="OnRecordDeployment"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <StackPanel x:Name="PoMine" Spacing="2" />
                    <StackPanel x:Name="PoModes" Spacing="4" />
                    <TextBlock x:Name="PoOpsHead" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="PoOpsLine" FontSize="11"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="PoSchemaLine" FontSize="11"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <Button x:Name="PoBaaButton" Click="OnBaaStatus"
                            Background="Transparent" FontSize="12"
                            Foreground="{StaticResource PdiBrandABrush}" />
                    <TextBlock x:Name="PoBaaLine" FontSize="11" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="PoError" Foreground="{StaticResource PdiRedBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Positions: the assistant builder, from the smallest honest
                 intake — an industry and a job title. -->
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="PsTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="PsIndustryBox" Width="160" />
                        <TextBox x:Name="PsTitleBox" Width="160" />
                        <Button x:Name="PsBuildButton" Click="OnBuildPosition"
                                Background="{StaticResource PdiBrandABrush}" Foreground="White" FontSize="12" />
                        <Button x:Name="PsOpenButton" Click="OnOpenPosition"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="PsLine" FontSize="11" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="PsSaved" FontSize="11"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="PsError" Foreground="{StaticResource PdiRedBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- The console's guide, from the desktop: the walkthrough,
                 a question, one of PDI's own notes translated. -->
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="GdTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="GdOutline" FontSize="11" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="GdStartButton" Click="OnGuideStart"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="GdDoneButton" Click="OnGuideDone"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="GdStepButton" Click="OnGuideStep"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="GdScreenButton" Click="OnGuideForScreen"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="GdProgress" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="GdStepLine" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="GdQBox" Width="240" />
                        <Button x:Name="GdAskButton" Click="OnConsoleAsk"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="GdAnswer" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="GdTextBox" Width="240" />
                        <Button x:Name="GdTrButton" Click="OnTranslate"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="GdTrLine" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="GdError" Foreground="{StaticResource PdiRedBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- The pane in the corner: its public vocabulary, this tenant's
                 arrangement, and one face as the pane would draw it. -->
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="DkTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <TextBlock x:Name="DkVocab" FontSize="11" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBox x:Name="DkTidBox" Width="240" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DkOpenButton" Click="OnDockOpen"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="DkCornerButton" Click="OnDockOtherCorner"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="DkShowButton" Click="OnDockFace"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="DkUseButton" Click="OnDockWhere"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                    </StackPanel>
                    <TextBlock x:Name="DkCurrent" FontSize="11" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="DkFaceLine" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="DkWhereLine" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="DkError" Foreground="{StaticResource PdiRedBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- The key itself: whose hands it is in. -->
            <Border Background="{StaticResource PdiCardBrush}" BorderBrush="{StaticResource PdiLineBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="CkTitle" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PdiTxtBrush}" />
                    <PasswordBox x:Name="CkKeyBox" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CkHoldButton" Click="OnKeyHold"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="CkKmsButton" Click="OnKeyKms"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiBrandABrush}" />
                        <Button x:Name="CkHandbackButton" Click="OnKeyHandback"
                                Background="Transparent" FontSize="12"
                                Foreground="{StaticResource PdiRedBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="CkNote" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <PasswordBox x:Name="CkAdminBox" />
                    <Button x:Name="CkResealButton" Click="OnReseal"
                            Background="Transparent" FontSize="12"
                            Foreground="{StaticResource PdiBrandABrush}" />
                    <TextBlock x:Name="CkResealLine" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource PdiT2Brush}" />
                    <TextBlock x:Name="CkError" Foreground="{StaticResource PdiRedBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
