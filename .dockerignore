# Kept out of the build context. The image builds the console itself (stage 1)
# and installs the package (stage 2), so nothing built locally should ride
# along — a stale local dist shipping instead of a fresh build is the bug this
# prevents.
**/node_modules
**/dist
**/release
**/__pycache__
**/*.pyc
*.egg-info
.venv
.git
.github

# A vault database must never be baked into an image — nor the WAL beside it,
# which holds recently sealed records the main file has not absorbed yet.
*.db
*.db-*

# Design, native-app, and packaging material the service does not serve.
docs/screens
docs/desktop
native
assets
